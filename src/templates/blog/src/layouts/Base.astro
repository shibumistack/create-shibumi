---
import BaseHead from "../components/BaseHead.astro";
import { SITE } from "../site";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  publishedTime?: Date;
  markdownPath?: string;
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body>
    <header>
      <a href="/" class="mark">
        <svg class="mark-badge" viewBox="0 0 60 104" aria-hidden="true"><rect x="4" y="4" width="52" height="96" rx="14" fill="none" stroke="currentColor" stroke-width="5" /><text x="30" y="32" text-anchor="middle" dominant-baseline="central" font-size="30" fill="currentColor" font-family="Hiragino Sans, Noto Sans JP, sans-serif">渋</text><text x="30" y="70" text-anchor="middle" dominant-baseline="central" font-size="30" fill="currentColor" font-family="Hiragino Sans, Noto Sans JP, sans-serif">み</text></svg>
        <span>{SITE.name}</span>
      </a>
    </header>
    <main>
      <slot />
    </main>
    <footer>© {new Date().getFullYear()} {SITE.author} · <a href="/rss.xml">RSS</a> · <a href="/llms.txt">llms.txt</a></footer>
  </body>
</html>
