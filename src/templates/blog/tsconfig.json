{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "types": [
      "bun-types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "serve.ts",
    "scripts"
  ]
}