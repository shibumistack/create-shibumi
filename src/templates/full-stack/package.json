{
  "name": "shibumi-full-stack-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/ship.ts --dev",
    "dev:app": "bun --watch src/server.ts",
    "start": "bun dist/server.js",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "test": "bun test",
    "check": "tsc --noEmit",
    "ship": "bun scripts/ship.ts",
    "ship:setup": "bun scripts/ship.ts --setup",
    "ship:update": "bun scripts/ship.ts --update",
    "ship:status": "bun scripts/ship.ts --status",
    "ship:logs": "bun scripts/ship.ts --logs",
    "ship:env": "bun scripts/ship.ts --env",
    "shibumi": "bun scripts/shibumi.ts",
    "shi": "bun scripts/shibumi.ts",
    "db:migrate": "bun scripts/db.ts migrate",
    "db:backup": "bun scripts/db.ts backup",
    "db:restore": "bun scripts/db.ts restore",
    "db:status": "bun scripts/db.ts status"
  },
  "dependencies": {
    "hono": "4.13.3",
    "zod": "4.4.3",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@clack/prompts": "1.7.0",
    "@types/bun": "1.4.0",
    "typescript": "5.9.2",
    "drizzle-kit": "0.31.10"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
