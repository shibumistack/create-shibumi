{
  "name": "create-shibumi",
  "version": "0.3.6",
  "description": "Scaffold a Shibumi Stack project: Bun, Hono, Zod, Drizzle, SQLite, Alpine",
  "type": "module",
  "bin": {
    "create-shibumi": "src/cli.ts"
  },
  "files": [
    "src/cli.ts",
    "src/args.ts",
    "src/adopt.ts",
    "src/create.ts",
    "src/templates/ship.ts",
    "src/templates/shibumi.ts",
    "scripts/ship.lock.json",
    "scripts/shibumi.lock.json",
    "src/templates/static/",
    "src/templates/blog/",
    "src/templates/full-stack/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test test",
    "test:e2e": "bun scripts/e2e.ts",
    "test:e2e:matrix": "bun scripts/e2e-matrix.ts",
    "check": "bun check --no-script",
    "sync:ship": "bun scripts/sync-ship.ts",
    "sync:extensions": "bun scripts/sync-extensions.ts",
    "verify:packed": "bun scripts/verify-packed.ts",
    "sync:css": "bun scripts/sync-shibumi-css.ts"
  },
  "keywords": [
    "shibumi",
    "scaffold",
    "cli",
    "bun",
    "hono",
    "drizzle",
    "alpine",
    "zod",
    "starter",
    "template"
  ],
  "author": "Shibumi Stack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shibumistack/create-shibumi.git"
  },
  "homepage": "https://shibumistack.dev",
  "dependencies": {
    "@clack/prompts": "1.7.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
